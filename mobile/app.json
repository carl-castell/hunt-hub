{
  "expo": {
    "name": "Hunt Hub",
    "slug": "hunt-hub",
    "scheme": "hunthub",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hunthub.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hunt Hub shows your position on the area map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
