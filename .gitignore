# Dependencies
node_modules/

# Environment files (the .env.example templates are committed)
**/.env
**/.env.*
!**/.env.example

# Build output and test coverage (regenerated on every build)
dist/
build/
coverage/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Mobile app: generated by Expo. The native ios/ and android/ projects
# are rebuilt from mobile/app.json, so they are never committed.
mobile/.expo/
mobile/ios/
mobile/android/
mobile/expo-env.d.ts

# OS and editor files
**/.DS_Store
.idea/

# Local tool config
.claudeignore
